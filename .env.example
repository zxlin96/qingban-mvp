# 讯飞星辰 Coding Plan 配置
# 获取 API Key: https://maas.xfyun.cn/packageSubscription
# 接入文档:   https://www.xfyun.cn/doc/spark/CodingPlan.html

XF_API_KEY=your-coding-plan-api-key
XF_BASE_URL=https://maas-coding-api.cn-huabei-1.xf-yun.com/v2
XF_MODEL=astron-code-latest
PORT=3000

# 提示词评测（npm run prompt:eval）连接配置 — app-config 内置 Key 已移除，评测前需自配
# PEV_API_FORMAT 取 anthropic | openai，须与 PEV_BASE_URL 的协议匹配
# PEV_API_KEY=sk-your-eval-key
# PEV_BASE_URL=https://api.kimi.com/coding
# PEV_MODEL=k3
# PEV_API_FORMAT=anthropic
